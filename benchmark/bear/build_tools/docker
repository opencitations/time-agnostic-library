set -euo pipefail

if [ "$1" = run ]; then
    shift
    exec "$BEAR_DOCKER" run --cgroup-parent "$BEAR_BUILD_SLICE" \
        --label "bear.build=$BEAR_BUILD_ID" "$@"
fi
exec "$BEAR_DOCKER" "$@"
